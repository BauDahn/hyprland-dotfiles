@import "mocha.rasi"

window { width: 1620px; height: 900px; }
mainbox { children: [ inputbar, listview ]; }
inputbar { children: [ entry ]; }
entry { placeholder: "Buscar ventana..."; }
listview { columns: 3; lines: 2; flow: horizontal; spacing: 16px; }
element { padding: 12px; spacing: 8px; }
element-icon { size: 300px; border-radius: 12px; }
element-text { horizontal-align: 0.5; }
